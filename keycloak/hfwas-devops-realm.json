{
  "id": "hfwas-devops",
  "realm": "hfwas-devops",
  "displayName": "HFWAS DevOps",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging", "hfwas-http"],
  "enabledEventTypes": ["LOGIN", "LOGIN_ERROR", "LOGOUT"],
  "clients": [
    {
      "clientId": "hfwas-devops-web",
      "name": "hfwas-devops web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:8000",
      "baseUrl": "/",
      "redirectUris": [
        "/*",
        "/",
        "http://localhost:8000",
        "http://localhost:8000/",
        "http://localhost:8000/*",
        "http://localhost:5173",
        "http://localhost:5173/",
        "http://localhost:5173/*",
        "http://127.0.0.1:8000",
        "http://127.0.0.1:8000/",
        "http://127.0.0.1:8000/*",
        "http://127.0.0.1:5173",
        "http://127.0.0.1:5173/",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "+",
        "http://localhost:8000",
        "http://localhost:5173",
        "http://127.0.0.1:8000",
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+##http://localhost:8000/*##http://localhost:5173/*##http://127.0.0.1:8000/*##http://127.0.0.1:5173/*"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "系统",
      "lastName": "管理员",
      "email": "admin@localhost",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ]
    }
  ]
}
