      "hash": "#/list",
      "states": ["default", "filtered", "selected", "dense", "long"]
    },
    { "id": "P02", "name": "工作项列表 · 空态", "route": "/pm/projects/:projectId/items/:typeCode", "hash": "#/list?state=empty", "states": ["empty"] },
    { "id": "P03", "name": "工作项列表 · 加载", "route": "/pm/projects/:projectId/items/:typeCode", "hash": "#/list?state=loading", "states": ["loading"] },
    { "id": "P04", "name": "工作项列表 · 失败", "route": "/pm/projects/:projectId/items/:typeCode", "hash": "#/list?state=error", "states": ["error"] },
    { "id": "P05", "name": "工作项列表 · 无权限", "route": "/pm/projects/:projectId/items/:typeCode", "hash": "#/list?state=permission", "states": ["permission"] },
    { "id": "P06", "name": "工作项列表 · 大数据量", "route": "/pm/projects/:projectId/items/:typeCode", "hash": "#/list?state=dense", "states": ["dense"] },
    { "id": "P07", "name": "工作项列表 · 长文本", "route": "/pm/projects/:projectId/items/:typeCode", "hash": "#/list?state=long", "states": ["long"] },
