  "contract": {
    "alignmentLevel": "A2",
    "referenceViewport": { "width": 1440, "height": 900, "scale": 2 },
    "mustMatch": ["layout", "spacing", "typography", "component", "copy", "state"],
    "mayDiffer": ["dynamicData", "conditionalVisibility", "responsive", "fontRendering"],
    "dataProfile": "pm-workbench-fixtures-v1"
  },
  "acceptance": [
    { "id": "AC-01", "page": "P01", "state": "default", "criterion": "一屏可见编号、类型、标题、状态、优先级、负责人、截止、更新时间；分页显示总数与每页条数" },
    { "id": "AC-02", "page": "P01", "state": "empty", "criterion": "搜索无结果展示空态、清空搜索入口，保留筛选条件" },
