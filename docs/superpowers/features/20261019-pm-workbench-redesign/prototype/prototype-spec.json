    { "id": "AC-05", "page": "O02", "state": "default", "criterion": "列可隐藏、调整顺序、恢复默认；密度可切换" },
    { "id": "AC-06", "page": "P01", "state": "sorted", "criterion": "点击表头切换升降序并显示箭头" },
    { "id": "AC-07", "page": "P01", "state": "default", "criterion": "分页支持每页条数、页码、跳页" },
    { "id": "AC-08", "page": "O03", "state": "default", "criterion": "批量删除二次确认写明数量与后果" },
    { "id": "AC-09", "page": "O04", "state": "default", "criterion": "快速预览抽屉展示关键字段，关闭后列表状态不丢" },
    { "id": "AC-10", "page": "P02-P05", "state": "empty/loading/error/permission", "criterion": "空态、加载、失败、无权限均可直达且文案完整" },
    { "id": "AC-11", "page": "P07", "state": "long", "criterion": "1440×900 无横向滚动，长标题省略不撑破列宽" },
    { "id": "AC-12", "page": "P05", "state": "permission", "criterion": "无权限隐藏新建、筛选应用与批量操作" }
  ]
