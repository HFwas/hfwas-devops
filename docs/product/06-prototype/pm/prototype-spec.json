    {
      "id": "AC-26",
      "page": "P01",
      "state": "default",
      "criterion": "列表分页支持每页 10/20/50/100，默认 10；页码、跳页与每页条数写入 URL；翻页清空选择；视图页签行、工具栏与分页使用同一总数"
    },
    {
      "id": "AC-27",
      "page": "O04",
