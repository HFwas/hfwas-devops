{
  "meta": {
    "name": "hfwas-devops · 流水线管理",
    "version": "v0.11",
    "date": "2026-10-18",
    "viewport": { "width": 1440, "height": 900, "minWidth": 1024 },
    "source": [
      "frontend/src/modules/pipeline",
      "backend/pipeline-core",
      "deploy/charts/backend/files/db/05-pipeline-schema.sql"
    ]
  },
  "tokens": {
    "color": {
      "background": { "light": "oklch(1 0 0)", "dark": "oklch(0.141 0.005 285.823)" },
      "foreground": { "light": "oklch(0.141 0.005 285.823)", "dark": "oklch(0.985 0 0)" },
      "card": { "light": "oklch(1 0 0)", "dark": "oklch(0.21 0.006 285.885)" },
      "primary": { "light": "oklch(0.55 0.22 235)", "dark": "oklch(0.65 0.18 235)" },
      "primaryForeground": { "light": "oklch(0.98 0.01 235)", "dark": "oklch(0.15 0.02 235)" },
      "muted": { "light": "oklch(0.967 0.001 286.375)", "dark": "oklch(0.274 0.006 286.033)" },
      "mutedForeground": { "light": "oklch(0.552 0.016 285.938)", "dark": "oklch(0.705 0.015 286.067)" },
      "border": { "light": "oklch(0.92 0.004 286.32)", "dark": "oklch(1 0 0 / 10%)" },
      "destructive": { "light": "oklch(0.577 0.245 27.325)", "dark": "oklch(0.704 0.191 22.216)" },
      "termBackground": { "light": "oklch(0.18 0.01 235)", "dark": "oklch(0.18 0.01 235)" },
      "termForeground": { "light": "oklch(0.85 0.005 235)", "dark": "oklch(0.85 0.005 235)" }
    },
    "radius": { "sm": 4, "md": 6, "lg": 8, "xl": 12 },
    "font": {
      "body": "ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Noto Sans, sans-serif",
      "mono": "Maple Mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "console": "Maple Mono, system sans fallback"
    },
    "layout": {
      "sidebarExpanded": 256,
      "sidebarCollapsed": 48,
      "sidebarMobile": 288,
      "headerHeight": 56,
      "contentPadding": 16,
      "contentPaddingLarge": 24,
      "contentGap": 16,
      "contentGapLarge": 24
    }
  },
  "shell": {
    "sidebar": {
      "variant": "inset",
      "collapsible": "icon",
      "navGroups": [
        { "key": "pipeline-work", "label": null, "items": ["pipelines"] },
        { "key": "pipeline-config", "label": "配置", "items": ["task-kinds", "credentials"] }
      ],
      "navItems": [
        { "key": "pipelines", "label": "流水线", "path": "/pipeline/pipelines", "icon": "GitBranch", "group": "pipeline-work" },
        { "key": "task-kinds", "label": "任务市场", "path": "/pipeline/task-kinds", "icon": "Package", "group": "pipeline-config" },
        { "key": "credentials", "label": "凭证", "path": "/pipeline/credentials", "icon": "KeyRound", "group": "pipeline-config" }
      ]
    },
    "header": {
      "height": 56,
      "sticky": true,
      "elements": ["SidebarTrigger", "Breadcrumb", "GlobalSearch", "TenantSwitcher", "ThemeToggle", "AvatarMenu"],
      "globalSearch": {
        "pipeline": { "placeholder": "搜索流水线名称", "label": "搜索流水线", "submit": "/pipeline/pipelines?q={keyword}" }
      }
    },
    "breadcrumbs": [
      { "path": "/pipeline/pipelines", "items": ["流水线"] },
      { "path": "/pipeline/pipelines/new", "items": ["流水线", "新建流水线"] },
      { "path": "/pipeline/pipelines/:id", "items": ["流水线", "流水线名称"] },
      { "path": "/pipeline/pipelines/:id/history", "items": ["流水线", "流水线名称", "运行历史"] },
      { "path": "/pipeline/pipelines/:id/edit", "items": ["流水线", "流水线名称", "编辑"] },
      { "path": "/pipeline/pipelines/:id/runs/:runId", "items": ["流水线", "流水线名称", "运行 #ID"] }
    ]
  },
  "pages": [
    {
      "id": "pipeline-list",
      "frame": "P01_PipelineList_Desktop",
      "name": "流水线列表",
      "route": "/pipeline/pipelines",
      "entry": ["sidebar:pipelines"],
      "regions": [
        {
          "id": "pageHeader",
          "component": "PageHeader",
          "layout": "horizontal",
          "elements": [
            { "type": "heading", "text": "流水线" },
            { "type": "caption", "text": "共 N 条流水线", "binding": "total" },
            { "type": "searchInput", "placeholder": "搜索流水线、仓库或分支", "width": 256 },
            { "type": "button", "label": "新建流水线", "variant": "primary", "action": "L03" }
          ]
        },
        {
          "id": "filterBar",
          "component": "SegmentedControl",
          "options": ["全部", "运行中", "成功", "失败"],
          "hint": "状态筛选仅作用于当前页"
        },
        {
          "id": "table",
          "component": "DataTable",
          "columns": [
            { "id": "name", "header": "流水线名称", "width": "28%", "fields": ["name", "stages[].jobs[].name"] },
            { "id": "repo", "header": "仓库 / 分支", "width": "24%", "fields": ["repoUrl", "gitRef"] },
            { "id": "stages", "header": "阶段预览", "width": "16%", "fields": ["stages[]", "lastRunStatus"] },
            { "id": "lastRun", "header": "最近运行", "width": "auto", "fields": ["lastRunStatus", "lastRunTime", "lastRunId"] },
            { "id": "actions", "header": "操作", "width": 120, "actions": ["run", "more"], "moreMenu": ["edit", "delete"] }
          ]
        },
        { "id": "pagination", "component": "Pagination", "pageSize": 10 }
      ],
      "states": [
        { "id": "loading", "behavior": "4 行骨架屏" },
        { "id": "ready", "behavior": "正常数据" },
        { "id": "empty", "behavior": "还没有流水线" },
        { "id": "filteredEmpty", "behavior": "没有匹配的流水线" },
        { "id": "error", "behavior": "流水线列表加载失败" }
      ],
      "actions": [
        { "id": "L01", "element": "search", "trigger": "input", "condition": "300ms 防抖", "effect": "写 URL ?q 并重置页码", "api": "POST /pipeline/pipelines/page" },
        { "id": "L02", "element": "segmented", "trigger": "click", "effect": "仅过滤当前页 lastRunStatus" },
        { "id": "L03", "element": "createButton", "trigger": "click", "target": "P03_PipelineEditor_New_Desktop" },
        { "id": "L04", "element": "row|nameLink", "trigger": "click", "target": "P02_PipelineDetail_Desktop", "note": "整行可点；点击 a/button/input 不触发行点击" },
        { "id": "L04b", "element": "moreButton", "trigger": "click", "effect": "展开行内菜单：编辑 / 历史 / 删除" },
        { "id": "L05", "element": "lastRunLink", "trigger": "click", "target": "P05_RunDetail_Desktop" },
        { "id": "L06", "element": "runButton", "trigger": "click", "effect": "进入运行参数流程", "target": "O01_RunParams_Dialog|P05_RunDetail_Desktop" },
        { "id": "L07", "element": "editButton", "trigger": "click", "target": "P03B_PipelineEditor_Edit_Desktop" },
        { "id": "L09", "element": "deleteButton", "trigger": "click", "target": "O03_ConfirmDeletePipeline" },
        { "id": "L10", "element": "pagination", "trigger": "click", "effect": "写 URL ?page" }
      ]
    },
    {
      "id": "pipeline-detail",
      "frame": "P02_PipelineDetail_Desktop",
      "name": "流水线详情",
      "route": "/pipeline/pipelines/:id",
      "entry": ["pipeline-list:name", "breadcrumb"],
      "regions": [
        {
          "id": "stickyHeader",
          "component": "DetailShell",
          "elements": [
            { "type": "button", "label": "返回", "variant": "ghost", "action": "D01" },
            { "type": "heading", "text": "流水线名称", "binding": "name" },
            { "type": "status", "binding": "lastRunStatus" },
            { "type": "button", "label": "编辑", "variant": "outline", "action": "D02" },
            { "type": "button", "label": "运行", "variant": "primary", "action": "D03" }
          ]
        },
        { "id": "tabs", "component": "TabBar", "items": ["详情", "运行历史"], "value": "详情" },
        {
          "id": "metrics",
          "component": "MetricCards",
          "items": ["仓库", "分支", "Commit", "阶段", "最近运行", "凭证"]
        },
        { "id": "body", "component": "DefinitionCanvas", "readonly": true, "flow": ["开始", "阶段", "结束"] }
      ],
      "states": [
        { "id": "loading", "behavior": "加载中…" },
        { "id": "ready", "behavior": "渲染定义画布" },
        { "id": "error", "behavior": "流水线加载失败" },
        { "id": "emptyCanvas", "behavior": "这条流水线还没有阶段。点右上角「编辑」后，阶段会显示在这里。" }
      ],
      "actions": [
        { "id": "D01", "element": "backButton", "trigger": "click", "target": "P01_PipelineList_Desktop" },
        { "id": "D02", "element": "editButton", "trigger": "click", "target": "P03B_PipelineEditor_Edit_Desktop" },
        { "id": "D03", "element": "runButton", "trigger": "click", "target": "O01_RunParams_Dialog|P05_RunDetail_Desktop" },
        { "id": "D04", "element": "tabDefinition", "trigger": "click", "effect": "URL → /:id" },
        { "id": "D05", "element": "tabHistory", "trigger": "click", "target": "P04_PipelineHistory_Desktop" }
      ]
    },
    {
      "id": "pipeline-editor-new",
      "frame": "P03_PipelineEditor_New_Desktop",
      "name": "新建流水线",
      "route": "/pipeline/pipelines/new",
      "entry": ["pipeline-list:create"],
      "regions": [
        {
          "id": "topBar",
          "elements": [
            { "type": "heading", "text": "新建流水线" },
            { "type": "input", "label": "名称", "ariaLabel": "名称", "inlineAfterHeading": true, "required": true },
            { "type": "caption", "text": "最近克隆 repo · branch · commit", "binding": "lastRunClone", "visibleWhen": "lastRun.commitSha" },
            { "type": "button", "label": "取消", "variant": "outline", "action": "E01" },
            { "type": "button", "label": "保存", "variant": "outline", "action": "E03" },
            { "type": "button", "label": "保存并运行", "variant": "primary", "action": "E04" }
          ]
        },
        { "id": "errorBanner", "component": "ErrorText", "variant": "banner", "conditional": true },
        {
          "id": "lanes",
          "component": "LanesCanvas",
          "elements": ["stageArrow", "StageCard", "JobCard", "addJobButton", "addStageCard"],
          "stageWidth": 240,
          "scale": "fixed-100"
        },
        {
          "id": "sidePanel",
          "width": 352,
          "modes": [
            { "id": "add", "component": "TaskAddList", "groups": ["代码", "构建", "质量控制", "制品", "部署", "测试", "命令", "流程"] },
            {
              "id": "config",
              "component": "Inspector",
              "fields": ["任务名称", "任务类型", "命令", "参数绑定", "技术栈", "运行时", "工具版本"],
              "cloneConfig": [
                { "key": "REPO_URL", "label": "仓库地址", "required": true, "control": "input", "validation": "http/https + host + path" },
                { "key": "GIT_REF", "label": "代码分支", "required": false, "control": "input", "default": "main" },
                { "key": "CREDENTIAL_ID", "label": "凭证", "required": false, "control": "asyncSelect", "clearable": true }
              ]
            }
          ]
        }
      ],
      "states": [
        { "id": "new", "behavior": "空草稿，仅添加阶段" },
        { "id": "dirty", "behavior": "取消触发 O05" },
        { "id": "saving", "behavior": "按钮禁用" },
        { "id": "invalid", "behavior": "错误条 + 字段红框" },
        { "id": "addMode", "behavior": "右侧显示任务市场" },
        { "id": "recentClone", "behavior": "最近运行包含 commitSha 时，标题旁显示仓库 · 分支 · 短 SHA" },
        { "id": "cloneConfig", "behavior": "选中 CLONE 任务时检查器显示仓库地址 / 代码分支 / 凭证" },
        { "id": "identityLocked", "behavior": "新建页与编辑页任务名称/类型均只读；类型由添加任务选定，名称自动生成" },
        { "id": "cloneAdvancedHidden", "behavior": "CLONE 任务不显示高级设置（技术栈/运行时/工具版本）" },
        { "id": "configMode", "behavior": "右侧显示任务检查器" },
        { "id": "selected", "behavior": "任务卡 primary 边框 + ring" },
        { "id": "dragging", "behavior": "拖拽元素 50% 透明，目标阶段高亮" }
      ],
      "actions": [
        { "id": "E01", "element": "cancel", "trigger": "click", "condition": "无改动", "target": "P01_PipelineList_Desktop" },
        { "id": "E02", "element": "cancel", "trigger": "click", "condition": "有改动", "target": "O05_ConfirmDiscardChanges" },
        { "id": "E03", "element": "save", "trigger": "click|cmd+s", "effect": "校验 → 创建", "api": "POST /pipeline/pipelines" },
        { "id": "E04", "element": "saveAndRun", "trigger": "click", "effect": "保存 → 运行参数流程", "target": "O01_RunParams_Dialog|P05_RunDetail_Desktop" },
        { "id": "E05", "element": "addStage", "trigger": "click", "effect": "追加空阶段，名称预填「阶段 N」" },
        { "id": "E06", "element": "stageName", "trigger": "input", "effect": "更新草稿" },
        { "id": "E07", "element": "moveStage", "trigger": "click", "effect": "左移 / 右移" },
        { "id": "E08", "element": "removeStage", "trigger": "click", "effect": "移除阶段" },
        { "id": "E09", "element": "addJob", "trigger": "click", "effect": "打开任务市场" },
        { "id": "E10", "element": "taskKind", "trigger": "click", "effect": "添加到当前或新阶段" },
        { "id": "E11", "element": "jobCard", "trigger": "click", "effect": "选中并打开检查器" },
        { "id": "E12", "element": "moveJob", "trigger": "click", "effect": "上移 / 下移" },
        { "id": "E13", "element": "removeJob", "trigger": "click", "target": "O06_ConfirmDeleteJob" },
        { "id": "E14", "element": "drag", "trigger": "drop", "effect": "阶段 / 任务排序" },
        { "id": "E16", "element": "closeInspector", "trigger": "click", "effect": "取消选中" },
        { "id": "E17", "element": "window", "trigger": "beforeunload", "condition": "有改动", "effect": "浏览器离开确认" }
      ]
    },
    {
      "id": "pipeline-editor-edit",
      "frame": "P03B_PipelineEditor_Edit_Desktop",
      "name": "编辑流水线",
      "route": "/pipeline/pipelines/:id/edit",
      "entry": ["pipeline-list:edit", "pipeline-detail:edit"],
      "regions": [
        { "ref": "pipeline-editor-new", "note": "同 P03，标题为「编辑流水线」，初始数据来自 GET /pipeline/pipelines/{id}" }
      ],
      "states": [
        { "id": "editLoading", "behavior": "加载中…" },
        { "id": "editReady", "behavior": "已加载草稿" },
        { "id": "dirty", "behavior": "取消触发 O05" },
        { "id": "saving", "behavior": "按钮禁用" }
      ],
      "actions": [
        { "id": "EE01", "element": "save", "trigger": "click|cmd+s", "effect": "校验 → 更新", "api": "PUT /pipeline/pipelines/{id}" },
        { "id": "EE02", "element": "saveAndRun", "trigger": "click", "effect": "保存 → 运行参数流程", "target": "O01_RunParams_Dialog|P05_RunDetail_Desktop" }
      ]
    },
    {
      "id": "pipeline-history",
      "frame": "P04_PipelineHistory_Desktop",
      "name": "运行历史",
      "route": "/pipeline/pipelines/:id/history",
      "entry": ["pipeline-detail:tabHistory", "pipeline-list:history"],
      "regions": [
        { "id": "stickyHeader", "component": "DetailShell", "elements": ["返回", "流水线名称", "编辑", "运行"] },
        { "id": "tabs", "component": "TabBar", "items": ["详情", "运行历史"], "value": "运行历史" },
        { "id": "metrics", "component": "MetricCards", "items": ["仓库", "分支", "阶段", "最近运行", "凭证"] },
        {
          "id": "toolbar",
          "elements": [
            { "type": "select", "label": "状态", "options": ["全部", "运行中", "成功", "失败", "排队中", "待审批", "已取消"] },
            { "type": "select", "label": "时间", "options": ["近 24 小时", "近 7 天", "近 30 天", "全部时间"], "default": "近 7 天" },
            { "type": "searchInput", "placeholder": "搜索运行编号、分支", "width": 224 },
            { "type": "summary", "text": "最近 N 次中 M 条 · {range}成功率 X%" }
          ]
        },
        {
          "id": "table",
          "component": "DataTable",
          "columns": [
            { "id": "id", "header": "运行编号", "fields": ["id", "commitSha", "triggeredByName"] },
            { "id": "trigger", "header": "触发方式", "fields": ["trigger"] },
            { "id": "ref", "header": "分支", "fields": ["gitRef"] },
            { "id": "status", "header": "状态", "fields": ["status"] },
            { "id": "started", "header": "开始时间", "fields": ["startedAt"] },
            { "id": "duration", "header": "耗时", "fields": ["startedAt", "finishedAt"] },
            { "id": "actions", "header": "操作", "actions": ["viewDetail"] }
          ]
        },
        { "id": "pagination", "component": "Pagination", "pageSize": 10, "mode": "local" }
      ],
      "states": [
        { "id": "loading", "behavior": "骨架屏" },
        { "id": "ready", "behavior": "正常数据" },
        { "id": "noRuns", "behavior": "还没有运行。点击「运行」后会打开这次运行的详情。" },
        { "id": "filteredEmpty", "behavior": "没有符合筛选的运行" },
        { "id": "error", "behavior": "运行记录加载失败" },
        { "id": "polling", "behavior": "存在非终态时每 4s 刷新" }
      ],
      "actions": [
        { "id": "H01", "element": "statusSelect", "trigger": "change", "effect": "写 URL ?status" },
        { "id": "H02", "element": "rangeSelect", "trigger": "change", "effect": "写 URL ?range" },
        { "id": "H03", "element": "search", "trigger": "input", "condition": "300ms 防抖", "effect": "写 URL ?q" },
        { "id": "H04", "element": "row", "trigger": "click", "target": "P05_RunDetail_Desktop" },
        { "id": "H05", "element": "viewDetail", "trigger": "click", "target": "P05_RunDetail_Desktop" },
        { "id": "H06", "element": "pagination", "trigger": "click", "effect": "本地分页 + URL ?page" }
      ]
    },
    {
      "id": "run-detail",
      "frame": "P05_RunDetail_Desktop",
      "name": "运行详情",
      "route": "/pipeline/pipelines/:id/runs/:runId",
      "entry": ["pipeline-history:row", "run-start:redirect"],
      "regions": [
        {
          "id": "stickyHeader",
          "elements": [
            { "type": "button", "label": "返回", "action": "R01" },
            { "type": "heading", "text": "流水线名 #运行ID", "binding": ["pipelineName", "id"] },
            { "type": "description", "binding": ["errorMessage", "gitRef", "commitSha"] },
            { "type": "status", "binding": "status" },
            { "type": "button", "label": "通过", "condition": "status == WAITING_APPROVAL", "action": "R02" },
            { "type": "button", "label": "取消", "condition": "status not terminal", "action": "R03" }
          ]
        },
        {
          "id": "fields",
          "component": "FieldRow",
          "items": [
            { "label": "触发", "binding": "trigger", "format": "triggerLabel" },
            { "label": "触发人", "binding": "triggeredByName" },
            { "label": "开始", "binding": "startedAt" },
            { "label": "耗时", "binding": ["startedAt", "finishedAt"] }
          ]
        },
        {
          "id": "swimlane",
          "component": "RunSwimlane",
          "flow": ["开始", "阶段", "结束"],
          "stageWidth": 176,
          "elements": ["stageCard", "stageLogButton", "jobItem", "jobLogButton", "overallLogButton"]
        }
      ],
      "states": [
        { "id": "loading", "behavior": "加载中…" },
        { "id": "live", "behavior": "3s 轮询 + 1s 计时" },
        { "id": "waitingApproval", "behavior": "显示通过按钮" },
        { "id": "terminal", "behavior": "停止轮询" },
        { "id": "error", "behavior": "运行详情加载失败" }
      ],
      "actions": [
        { "id": "R01", "element": "back", "trigger": "click", "effect": "来源感知：有应用内历史时 history.back()，否则跳 P04_PipelineHistory_Desktop" },
        { "id": "R02", "element": "approve", "trigger": "click", "api": "POST /pipeline/pipelines/{id}/runs/{runId}/approve" },
        { "id": "R03", "element": "cancel", "trigger": "click", "target": "O04_ConfirmCancelRun" },
        { "id": "R04", "element": "overallLog", "trigger": "click", "target": "O02_LogDrawer_Right", "focus": "overall" },
        { "id": "R05", "element": "stageLog", "trigger": "click", "target": "O02_LogDrawer_Right", "focus": "stage" },
        { "id": "R06", "element": "jobLog", "trigger": "click", "target": "O02_LogDrawer_Right", "focus": "job" },
        { "id": "R07", "element": "page", "trigger": "interval", "condition": "非终态", "effect": "每 3s 刷新" }
      ]
    },
    {
      "id": "pipeline-credentials",
      "frame": "P06_PipelineCredentials_Desktop",
      "name": "凭证",
      "route": "/pipeline/credentials",
      "entry": ["sidebar:credentials"],
      "regions": [
        {
          "id": "pageHeader",
          "component": "PageHeader",
          "elements": [
            { "type": "heading", "text": "凭证" },
            { "type": "caption", "text": "共 N 条凭证", "binding": "total" },
            { "type": "searchInput", "placeholder": "搜索名称", "width": 224 },
            { "type": "button", "label": "新建凭证", "variant": "primary", "action": "C01" }
          ]
        },
        {
          "id": "table",
          "component": "DataTable",
          "columns": [
            { "id": "name", "header": "名称", "width": "30%" },
            { "id": "kind", "header": "类型", "width": "20%" },
            { "id": "username", "header": "用户名", "width": "auto" },
            { "id": "updated", "header": "更新时间", "width": 180 },
            { "id": "actions", "header": "", "width": 100, "actions": ["delete"] }
          ]
        },
        { "id": "pagination", "component": "Pagination", "pageSize": 10 }
      ],
      "states": [
        { "id": "ready", "behavior": "正常数据" },
        { "id": "empty", "behavior": "还没有凭证" },
        { "id": "formInvalid", "behavior": "名称为空：字段级错误「请填写名称」，聚焦名称输入框，不发请求" }
      ],
      "actions": [
        { "id": "C01", "element": "createButton", "trigger": "click", "target": "O07_CreateCredential_Dialog" },
        { "id": "C02", "element": "nameLink", "trigger": "click", "target": "P07_CredentialDetail_Desktop" }
      ]
    }
  ],
  "overlays": [
    {
      "id": "credential-new",
      "frame": "O07_CreateCredential_Dialog",
      "name": "新建凭证",
      "trigger": ["C01"],
      "content": {
        "title": "新建凭证",
        "fields": ["name*", "kind", "username", "secret"],
        "footer": ["取消", "保存"]
      },
      "validation": { "name": "必填；错误就地显示并聚焦首个错误字段" },
      "confirm": { "api": "POST /pipeline/credentials", "effect": "Toast 凭证已保存 + 刷新列表" },
      "cancel": "关闭",
      "close": ["X", "scrim", "Esc"]
    },
    {
      "id": "run-params",
      "frame": "O01_RunParams_Dialog",
      "name": "运行参数",
      "trigger": ["L06", "D03", "E04", "EE02"],
      "condition": "GET /runs/default-params 返回非空",
      "content": {
        "title": "运行参数",
        "fields": ["paramKey", "paramLabel", "paramType", "defaultValue", "required", "options", "placeholder"],
        "controls": ["input", "select"],
        "footer": ["取消", "运行"]
      },
      "confirm": { "validate": "required", "api": "POST /pipeline/pipelines/{id}/runs", "effect": "跳转 P05" },
      "cancel": "关闭弹窗",
      "close": ["X", "scrim", "Esc"]
    },
    {
      "id": "delete-pipeline",
      "frame": "O03_ConfirmDeletePipeline",
      "name": "删除流水线确认",
      "trigger": ["L09"],
      "content": {
        "title": "删除流水线「名称」？",
        "description": "删除后无法恢复，运行历史会一并移除。",
        "footer": ["取消", "删除"]
      },
      "confirm": { "api": "DELETE /pipeline/pipelines/{id}", "effect": "Toast 已删除 + 刷新列表", "destructive": true },
      "cancel": "关闭",
      "close": ["X", "scrim", "Esc"]
    },
    {
      "id": "cancel-run",
      "frame": "O04_ConfirmCancelRun",
      "name": "取消运行确认",
      "trigger": ["R03"],
      "condition": "运行非终态",
      "content": {
        "title": "取消运行 #ID？",
        "description": "正在执行的任务会被中止。",
        "footer": ["继续运行", "取消运行"]
      },
      "confirm": { "api": "POST /pipeline/pipelines/{id}/runs/{runId}/cancel", "effect": "Toast 已取消运行 + 刷新", "destructive": true },
      "cancel": "关闭",
      "close": ["X", "scrim", "Esc"]
    },
    {
      "id": "discard-changes",
      "frame": "O05_ConfirmDiscardChanges",
      "name": "放弃修改确认",
      "trigger": ["E02"],
      "condition": "草稿与保存快照不一致",
      "content": {
        "title": "放弃未保存的修改？",
        "description": "未保存的改动会丢失。",
        "footer": ["取消", "放弃"]
      },
      "confirm": { "effect": "返回列表", "destructive": true },
      "cancel": "留在编辑页",
      "close": ["X", "scrim", "Esc"]
    },
    {
      "id": "delete-job",
      "frame": "O06_ConfirmDeleteJob",
      "name": "删除任务确认",
      "trigger": ["E13"],
      "content": {
        "title": "删除任务「名称」？",
        "footer": ["取消", "删除"]
      },
      "confirm": { "effect": "从草稿移除任务", "destructive": true },
      "cancel": "关闭",
      "close": ["X", "scrim", "Esc"]
    },
    {
      "id": "log-drawer",
      "frame": "O02_LogDrawer_Right",
      "name": "日志抽屉",
      "trigger": ["R04", "R05", "R06"],
      "content": {
        "side": "right",
        "width": "min(720, 92vw)",
        "variant": "terminal",
        "titleByFocus": { "overall": "全程日志", "stage": "阶段 · 名称", "job": "阶段名 / 任务名" },
        "connection": ["连接中", "已连接", "未连接"],
        "actions": ["跟随最新"]
      },
      "close": ["X", "scrim", "Esc"],
      "autoClose": "焦点任务或阶段不存在时"
    }
  ],
